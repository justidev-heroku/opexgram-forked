uniform float2 size;
uniform float corner;
uniform float band;
uniform float density;
uniform float time;
uniform float shown;
uniform float progress;
uniform float fail;
uniform float comet;
layout(color) uniform half4 cf;
layout(color) uniform half4 c0;
layout(color) uniform half4 c1;
layout(color) uniform half4 c2;
layout(color) uniform half4 c3;

const float TAU = 6.2831853;

float edgeDistance(float2 p, float2 extent, float r) {
    float2 q = abs(p) - extent + r;
    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
}

float3 palette(float h) {
    float x = fract(h) * 4.0;
    float3 color = mix(float3(c0.rgb), float3(c1.rgb), smoothstep(0.0, 1.0, x));
    color = mix(color, float3(c2.rgb), smoothstep(1.0, 2.0, x));
    color = mix(color, float3(c3.rgb), smoothstep(2.0, 3.0, x));
    return mix(color, float3(c0.rgb), smoothstep(3.0, 4.0, x));
}

half4 main(float2 p) {
    float2 center = size * 0.5;
    float d = max(0.0, -edgeDistance(p - center, center, corner));
    float retract = max(1.0 - fail, 0.04);
    float2 q = (p - center) / center;
    float s = atan(q.y, q.x) / TAU;
    float swirl = sin(s * TAU * 2.0 + time * 1.3) * sin(s * TAU * 3.0 - time * 0.9);
    float pulse = 0.5 + 0.5 * mix(swirl, sin(time * 1.3) * sin(-time * 0.9), progress);
    float spread = (0.55 + 0.45 * pulse) * (0.35 + 0.65 * shown) * (1.0 + 0.35 * progress) * retract;
    float rim = exp(-d / (2.0 * density * retract));
    float mid = exp(-d / (8.0 * density * spread));
    float bloom = exp(-d / (band * spread));
    float3 color = mix(palette(s + time * 0.07), palette(time * 0.07), progress);
    float3 accent = mix(palette(0.5 - s + time * 0.045), palette(0.5 + time * 0.045), progress);
    float blend = mix(sin(time * 0.8 + s * TAU * 2.0), sin(time * 0.8), progress);
    color = mix(color, accent, 0.5 + 0.5 * blend);
    color = mix(color, float3(cf.rgb), sqrt(fail));
    float breath = 0.9 + 0.1 * sin(time * 2.1);
    float energy = 1.0 + 0.3 * progress;
    float head = fract(s - time * (0.16 + 0.42 * progress));
    float span = 0.1 + 0.05 * progress;
    float chase = 0.22 + 0.78 * exp(-pow(min(abs(head - 0.25), abs(head - 0.75)) / span, 2.0));
    float alpha = clamp((rim * 0.95 + mid * 0.5 + bloom * 0.28) * energy, 0.0, 1.0) * shown * breath;
    alpha = alpha * mix(1.0, chase, comet * (1.0 - fail));
    return half4(half3(color * alpha), half(alpha));
}
