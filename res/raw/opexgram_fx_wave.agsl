uniform shader img;
uniform float2 size;
uniform float density;
uniform int count;
uniform float[4] centerX;
uniform float[4] centerY;
uniform float[4] halfWidth;
uniform float[4] halfHeight;
uniform float[4] corner;
uniform float[4] front;
uniform float[4] fade;
layout(color) uniform half4 c0;
layout(color) uniform half4 c1;
layout(color) uniform half4 c2;
layout(color) uniform half4 c3;

const float TAU = 6.2831853;
const float PEAK = 2.3316;

float shapeDistance(float2 d, float2 extent, float r) {
    float2 q = abs(d) - max(extent - r, float2(0.0));
    return max(min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r, 0.0);
}

float3 palette(float h) {
    float x = fract(h) * 4.0;
    float3 color = mix(float3(c0.rgb), float3(c1.rgb), smoothstep(0.0, 1.0, x));
    color = mix(color, float3(c2.rgb), smoothstep(1.0, 2.0, x));
    color = mix(color, float3(c3.rgb), smoothstep(2.0, 3.0, x));
    return mix(color, float3(c0.rgb), smoothstep(3.0, 4.0, x));
}

half4 main(float2 p) {
    float2 offset = float2(0.0);
    float3 tint = float3(0.0);
    float weight = 0.0;
    for (int i = 0; i < 4; i++) {
        if (i >= count) {
            break;
        }
        float2 d = p - float2(centerX[i], centerY[i]);
        float dist = shapeDistance(d, float2(halfWidth[i], halfHeight[i]), corner[i]);
        float spread = 28.0 * density + front[i] * 0.06;
        float x = (dist - front[i]) / spread;
        if (abs(x) < 4.0) {
            float shape = exp(-x * x);
            float2 dir = d / max(length(d), 1.0);
            offset += dir * (x * shape * PEAK) * (11.0 * density) * fade[i];
            float crest = exp(-x * x * 3.0) * fade[i];
            tint += palette(atan(d.y, d.x) / TAU + front[i] / size.y * 0.35) * crest;
            weight += crest;
        }
    }
    float edge = min(min(p.x, size.x - p.x), min(p.y, size.y - p.y));
    offset *= clamp(edge / (24.0 * density), 0.0, 1.0);
    float2 uv = p - offset;
    float4 color = float4(img.eval(uv));
    if (dot(offset, offset) > 0.25) {
        float2 shift = offset * 0.22;
        color.r = float(img.eval(uv - shift).r);
        color.b = float(img.eval(uv + shift).b);
        color.rgb = min(color.rgb, float3(color.a));
    }
    if (weight > 0.001) {
        float alpha = clamp(weight * 0.45, 0.0, 0.6);
        color.rgb = color.rgb * (1.0 - alpha) + (tint / weight) * alpha;
        color.a = color.a * (1.0 - alpha) + alpha;
    }
    return half4(color);
}
